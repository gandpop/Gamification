.drawer {
    position: absolute;
    top: 40px;
    right: 0;
    flex-direction: row;
    align-items: flex-start;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.drawer--closed {
    translate: 260px 0;
}

.drawer--open {
    translate: 0 0;
}

.drawer-tab {
    width: 40px;
    height: 60px;
    align-self: center;
    background-color: rgb(102, 188, 181);
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    -unity-font-style: bold;
}

.drawer-content {
    width: 260px;
    min-height: 320px;
    background-color: rgb(40, 40, 40);
    padding: 10px;
}

.drawer-title {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.drawer-list {
    flex-grow: 1;
}

.achievement-row {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.achievement-row--locked {
    opacity: 0.4;
}

.achievement-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    background-color: rgb(102, 188, 181);
}

.achievement-label {
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
