:root {
}

.unity-base-field {
}

.unity-popup-field {
    -unity-font-definition: url("project://database/Assets/UI/Noah/monof55.ttf?fileID=12800000&guid=111af795b0311a1439560254510a5957&type=3#monof55");
}

.unity-base-popup-field {
    flex-direction: column;
    min-width: 245px;
    flex-wrap: nowrap;
    aspect-ratio: auto;
    margin-top: 70px;
    margin-bottom: -30px;
    margin-left: 20px;
    margin-right: 20px;
    align-self: center;
    min-height: 88px;
    -unity-font-definition: url("project://database/Assets/UI/Noah/monof55.ttf?fileID=12800000&guid=111af795b0311a1439560254510a5957&type=3#monof55");
    font-size: 20px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: upper-left;
    text-overflow: clip;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: stretch;
    flex-basis: initial;
    flex-grow: 0;
    opacity: 1;
    visibility: visible;
    overflow: hidden;
    padding-right: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    padding-top: 0;
    padding-bottom: 0;
}

.unity-button {
    -unity-font-definition: url("project://database/Assets/UI/Noah/monof55.ttf?fileID=12800000&guid=111af795b0311a1439560254510a5957&type=3#monof55");
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    font-size: 21px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(102, 188, 181);
}



.unity-popup-field__input {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-top-left-radius: 0;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(235, 128, 46);
    -unity-text-align: upper-left;
}

.unity-popup-field__label {
    font-size: 26px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    margin-bottom: -3px;
    text-shadow: 0 1.3px 1.2px rgba(0, 0, 0, 0.624);
    color: rgb(0, 0, 0);
}



.unity-base-popup-field__text {
    color: rgb(0, 0, 0);
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-font-style: normal;
    margin-bottom: 0;
    padding-bottom: 0;
    flex-grow: 1;
    -unity-text-auto-size: none;
}
